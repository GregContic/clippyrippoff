{
  "output_width": 1080,
  "output_height": 1920,
  "fps": 30,
  "clip_min_seconds": 10,
  "clip_max_seconds": 60,
  "whisper_model": "base",
  "video_codec": "libx264",
  "audio_codec": "aac",
  "video_preset": "medium",
  "audio_bitrate": "192k",
  "video_crf": 20,
  "caption_font_size": 72,
  "caption_font_name": "Arial Black",
  "caption_bold": true,
  "caption_primary_color": "&H00FFFFFF",
  "caption_outline_color": "&H00000000",
  "caption_shadow_color": "&H80000000",
  "caption_outline_width": 4,
  "caption_shadow_depth": 3,
  "caption_max_chars_per_line": 18,
  "caption_max_lines": 2,
  "caption_vertical_margin_percent": 0.30,
  "caption_max_words_per_segment": 5,
  "normalize_audio": true,
  "reaction_keywords": {
    "weak": ["what", "what the", "how", "wait", "okay", "really", "wow"],
    "medium": ["no", "no way", "bro", "brooo", "holy", "insane", "crazy", "how did", "wait what", "are you serious", "did that just", "look at that"],
    "strong": ["oh my god", "let's go", "lets go", "holy shit", "what the fuck", "i can't believe"]
  },
  "reaction_strength_scores": {"weak": 3, "medium": 8, "strong": 15},
  "context_before_seconds": 5,
  "context_after_seconds": 8,
  "candidate_merge_gap_seconds": 3,
  "boundary_continuation_gap_seconds": 1.5,
  "boundary_quiet_seconds": 1.5,
  "boundary_scene_transition_threshold": 0.28,
  "audio_sample_rate": 16000,
  "audio_window_seconds": 0.25,
  "audio_baseline_seconds": 8,
  "audio_spike_threshold": 1.8,
  "audio_min_peak": 0.08,
  "scene_sample_fps": 1,
  "scene_change_threshold": 0.18,
  "scene_min_change_score": 0.18,
  "scene_max_width": 320,
  "max_candidates": 20,
  "youtube": {
    "enabled": true,
    "cache_enabled": true,
    "cleanup_downloads": false
  }
}
